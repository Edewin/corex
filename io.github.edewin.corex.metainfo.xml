  <name>CoreX HW Monitor</name>
  <developer id="io.github.edewin">
    <name>Eduard Soltuzu</name>
  </developer>
  <summary>Real-time hardware monitoring</summary>
<branding>
  <color type="primary" scheme_preference="light">#e8f5e9</color>
  <color type="primary" scheme_preference="dark">#1b5e20</color>
</branding>
  <description>
    <p>CoreX is a lightweight hardware monitor for Linux that keeps you informed about your system's health at all times.</p>
    <ul>
      <li>Every sensor of your PC in one list: CPU and GPU temperatures, fan speeds, voltages, power, clocks, disks and network, each with its minimum and maximum</li>
      <li>A dashboard with live charts per device, or charts only for the values you pick</li>
      <li>An always-on-top widget with the values you choose, visible while gaming, working or browsing</li>
      <li>Rename sensors, hide the ones you do not need; CoreX remembers your layout</li>
      <li>Can start with your system, straight into the widget</li>
      <li>Light on resources: it reads the kernel directly, no background services</li>
    </ul>
  </description>

  <keywords>
    <keyword>hardware monitor</keyword>
    <keyword>system monitor</keyword>
    <keyword>sensor</keyword>
    <keyword>sensors</keyword>
    <keyword>cpu</keyword>
    <keyword>gpu</keyword>
    <keyword>widget</keyword>
    <keyword>always-on-top</keyword>
  </keywords>

